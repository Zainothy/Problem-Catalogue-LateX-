@incollection{10.1093/acprof:oso/9780195311105.003.0001,
  author    = {Chalmers, David J.},
  isbn      = {9780195311105},
  title     = {Facing Up to the Problem of Consciousness},
  booktitle = {The Character of Consciousness},
  publisher = {Oxford University Press},
  year      = {2010},
  month     = {10},
  abstract  = {Consciousness poses the most baffling problems in the science of the mind. There is nothing that we know more intimately than conscious experience, but there is nothing that is harder to explain. All sorts of mental phenomena have yielded to scientific investigation in recent years, but consciousness has stubbornly resisted. This chapter first isolates the truly hard part of the problem of consciousness, separating it from more tractable parts and giving an account of why it is so difficult to explain. It critiques some recent work that uses reductive methods to address consciousness and argues that these methods inevitably fail to come to grips with the hardest part of the problem. Once this failure is recognized, the door to further progress is opened. The second half of the chapter argues that, if we move to a new kind of nonreductive explanation, a naturalistic account of consciousness can be given.},
  doi       = {10.1093/acprof:oso/9780195311105.003.0001},
  url       = {https://doi.org/10.1093/acprof:oso/9780195311105.003.0001},
  eprint    = {https://academic.oup.com/book/0/chapter/151305365/chapter-ag-pdf/44976872/book_6996_section_151305365.ag.pdf}
}
